{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LE Gear Advisor",
  "version": "0.1.1",
  "identifier": "gg.leadvisor.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LE Gear Advisor",
        "width": 460,
        "height": 340,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "shadow": false,
        "visible": true
      },
      {
        "label": "builds",
        "title": "LE Gear Advisor \u00b7 Builds & AI",
        "url": "index.html?window=builds",
        "width": 960,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../profile/character.json",
      "../../profile/settings.json"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}